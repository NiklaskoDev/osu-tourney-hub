# Copy to .env and fill in. Names and placeholders only - never real values in this file.
# Keep in sync with every variable the code reads, unraid/osu-tourney-hub.xml and the README.
# Run locally: export these in the shell (the app does not read .env itself), then
#   uvicorn app.main:app --reload --port 8080

# --- Required ---
# osu! OAuth application (osu.ppy.sh > Settings > OAuth > New OAuth Application)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Public address of this site, no path. Callback URL of the OAuth app = PUBLIC_URL/auth/callback
PUBLIC_URL=https://tourney.example.com
# At least 32 random characters, for example the output of: openssl rand -hex 32
SESSION_SECRET=
# osu! user ids of the administrators, comma-separated
ADMIN_OSU_IDS=

# --- Container ---
# User and group the container writes files as (Unraid default 99 / 100)
PUID=99
PGID=100
# Where the database lives inside the container (the image sets /data)
# DATA_DIR=/data

# --- Optional tuning (defaults shown) ---
# Read now: osu! API requests per minute (1 to 60), minutes between wybin syncs (minimum 10),
# seconds between two requests to wybin (1 to 60) and the log level
OSU_API_RATE_PER_MIN=60
WYBIN_POLL_MINUTES=30
WYBIN_MIN_INTERVAL_SECONDS=2
LOG_LEVEL=info
# The variables below are not read yet; the versions that add the matching feature will use them.
SCANNER_ENABLED=true
SCANNER_BUDGET_PER_MIN=30
SCANNER_WORKERS=4
SCANNER_MAX_BACKLOG=5000
SCANNER_OPEN_MAX_HOURS=24
CAPTURE_REFRESH_HOURS=24
LIVE_POLL_SECONDS=10

# --- Optional AI predictions (off while AI_PROVIDER is empty) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
