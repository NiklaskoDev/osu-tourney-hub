# Copy to .env and fill in. Names and placeholders only - never real values in this file.
# Keep in sync with every variable the code reads, unraid/osu-tourney-hub.xml and the README.
# Run locally: export these in the shell (the app does not read .env itself), then
#   uvicorn app.main:app --reload --port 8080

# --- Required ---
# osu! OAuth application (osu.ppy.sh > Settings > OAuth > New OAuth Application)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Public address of this site, no path. Callback URL of the OAuth app = PUBLIC_URL/auth/callback
PUBLIC_URL=https://tourney.example.com
# At least 32 random characters, for example the output of: openssl rand -hex 32
SESSION_SECRET=
# osu! user ids of the administrators, comma-separated
ADMIN_OSU_IDS=

# --- Container ---
# User and group the container writes files as (Unraid default 99 / 100)
PUID=99
PGID=100
# Where the database lives inside the container (the image sets /data)
# DATA_DIR=/data

# --- Optional tuning (defaults shown) ---
# Read now: osu! API requests per minute (1 to 60), minutes between wybin syncs (minimum 10),
# seconds between two requests to wybin (1 to 60), hours before a player's score on a map is
# fetched from osu! again (at least 1) and the log level
OSU_API_RATE_PER_MIN=60
WYBIN_POLL_MINUTES=30
WYBIN_MIN_INTERVAL_SECONDS=2
CAPTURE_REFRESH_HOURS=24
LOG_LEVEL=info
# Lobby scanner: on/off, osu! requests per minute it may use (must be lower than
# OSU_API_RATE_PER_MIN), parallel tasks (1 to 8), lobby ids it may fall behind before it skips
# ahead, and hours after which a still-open lobby is finalised
SCANNER_ENABLED=true
SCANNER_BUDGET_PER_MIN=30
SCANNER_WORKERS=4
SCANNER_MAX_BACKLOG=5000
SCANNER_OPEN_MAX_HOURS=24
# Live match mode: seconds between two reads of a lobby while a match is followed (minimum 5)
LIVE_POLL_SECONDS=10

# --- Optional AI predictions (off while AI_PROVIDER, AI_MODEL or the key is missing) ---
# AI_PROVIDER: anthropic, or openai for any OpenAI-compatible endpoint (OpenAI, OpenRouter, a
# local server). AI_MODEL is the model name, for example claude-sonnet-5-5. AI_API_KEY is not
# needed for an openai provider with its own AI_BASE_URL (a local server), for example
# http://192.168.1.20:11434/v1. AI_BASE_URL must be https, except for localhost,
# host.docker.internal, names without a dot (http://ollama:11434/v1), *.local and private addresses
# (10/8, 172.16/12, 192.168/16); an IPv6 LAN address needs https or a container name.
# Use a normal model such as claude-sonnet-5-5: thinking-only and extended-thinking modes are not
# supported (the anthropic provider forces a tool call).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
